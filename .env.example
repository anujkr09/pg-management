NODE_ENV=production
PORT=3002
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
TENANT_PASSWORD=replace-with-a-temporary-tenant-password
SESSION_TTL_MINUTES=120
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_ATTEMPTS=8
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/staywise_pg?retryWrites=true&w=majority
MONGODB_DB=staywise_pg
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret
BACKUP_INTERVAL_HOURS=24
PUBLIC_BASE_URL=https://your-domain.example
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="StayWise PG <alerts@example.com>"
ALLOW_ETHEREAL_TEST_EMAIL=false
NOTIFY_CHANNELS=email
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=whatsapp:+14155238886
TWILIO_MESSAGING_SERVICE_SID=
